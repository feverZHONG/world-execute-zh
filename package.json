{
  "name": "world-execute-zh",
  "version": "4.0.0",
  "description": "Mili《world.execute (me) ;》歌词 MV 的简体中文二创：界面与台词全量中文化、歌词一字未改（确定性渲染器）",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lyrics": "node tools/fill_lyrics.mjs",
    "lyrics:retime": "node tools/py.mjs tools/parse_lrc.py && node tools/fill_lyrics.mjs --table",
    "check:lyrics": "node tools/check_no_lyrics.mjs",
    "check:plates": "node tools/py.mjs tools/plate_check.py",
    "analyze": "node tools/py.mjs tools/analyze_audio.py",
    "preview": "node export/server.mjs --open",
    "export:sample": "node export/export.mjs --start 0 --end 41 --width 960 --height 540 --fps 30 --out out/sample_0-41_540p30.mp4",
    "export:preview": "node export/export.mjs --width 1920 --height 1080 --fps 60 --frame h264 --out out/preview_1080p60.mp4",
    "export:4k": "node export/export.mjs --width 3840 --height 2160 --fps 60 --frame h264 --out out/world_execute_me_4k60.mp4",
    "storyboard": "node tools/storyboard.mjs",
    "check": "node tools/check.mjs",
    "check:4k": "node tools/check.mjs out/world_execute_me_4k60.mp4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0"
  }
}
